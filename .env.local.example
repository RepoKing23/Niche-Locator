# DataForSEO API credentials — https://app.dataforseo.com/api-access
# (API login + API password, not your website login password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Supabase (login + saved keyword lists/reports). Leave empty to run without login,
# storing lists in this browser only. Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
